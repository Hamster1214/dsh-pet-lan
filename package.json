{
  "name": "dsh-pet-lan",
  "version": "0.5.2",
  "description": "LAN pets with dsh-pet 0.3.8 shared physics, real-time local collisions and exclusive collision ownership.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "runtime/desktop-helper",
    "scripts/patch-dsh-pet.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "assets/*.mp3",
    "assets/NOTICE.md",
    "runtime/shared",
    "scripts/patch-physics-038.mjs",
    "COMPATIBILITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "license": "MIT",
  "author": "Hamster1214",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "lan",
    "multiplayer",
    "bongo-cat"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hamster1214/dsh-pet-lan.git"
  },
  "homepage": "https://github.com/Hamster1214/dsh-pet-lan#readme",
  "bugs": {
    "url": "https://github.com/Hamster1214/dsh-pet-lan/issues"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "patch:physics": "node scripts/patch-physics-038.mjs"
  }
}
